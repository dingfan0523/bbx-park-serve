<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 请注意：本mapper文件由工具生成，自定义sql请重新创建文件编写，由于数据模型存在变更的可能性，该文件可能会被重新覆盖 -->
<mapper namespace="com.cgnpc.bbxpark.meeting.mapper.MeetingAttendantRoomRepository">
    <select id="listByUserId" resultType="com.cgnpc.bbxpark.meeting.dto.model.MeetingAttendantRoomModel">
        SELECT DISTINCT
        ar.id,
        ar.user_id,
        ar.room_id,
        ar.status,
        r.room_name,
        ar.create_time
        FROM bbx_meeting_attendant_room ar
        INNER JOIN bbx_meeting_room r ON ar.room_id = r.id
        <where>
            <if test="tenantId != null">
                AND ar.tenant_id =#{tenantId} AND r.tenant_id =#{tenantId}
            </if>
            <if test="userIdList != null and userIdList.size() > 0">
                AND ar.user_id in
                <foreach collection="userIdList " item="userId" open="(" separator=", "
                         close=")">
                    #{userId}
                </foreach>
            </if>
            <if test="status != null">
                AND ar.status = #{status}
            </if>
            AND r.deleted = 1
        </where>
        order by ar.status,ar.create_time DESC
    </select>
</mapper>
