<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cgnpc.framework.mapper.UserMapper">

	<!-- 通用查询结果列-->
	<sql id="Base_Column_List">
		id, name, age
	</sql>
<select id="getUser" parameterType="long" resultType="com.cgnpc.framework.domain.SysUser">
	SELECT * FROM cud_sys_user_t WHERE ID=#{id}
</select>
	<insert id="insertUser" flushCache="true" statementType="PREPARED" parameterType="com.cgnpc.framework.domain.SysUser"></insert>
</mapper>