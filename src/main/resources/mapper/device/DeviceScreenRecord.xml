<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 请注意：本mapper文件由工具生成，自定义sql请重新创建文件编写，由于数据模型存在变更的可能性，该文件可能会被重新覆盖 -->
<mapper namespace="com.cgnpc.bbxpark.device.mapper.DeviceScreenRecordRepository">

    <select id="getExecutionTrend" resultType="com.cgnpc.bbxpark.ioc.dto.model.ExecutionTrend">
        SELECT TRUNC(record_time) AS date,
        COUNT(*) AS executeCount
        FROM bbx_device_screen_record
        WHERE record_time >= TRUNC(SYSDATE) - 30
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        GROUP BY TRUNC(record_time) ORDER BY date
    </select>

</mapper>
