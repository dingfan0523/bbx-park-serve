<mapper namespace="com.cgnpc.bbxpark.traffic.mapper.DwdVehicleInfoRepository">
    <select id="getVehicleTypeDistribution" resultType="com.cgnpc.bbxpark.ioc.dto.model.TrafficVehicleTypeModel">
